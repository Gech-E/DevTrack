{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm --filter @devtrack/shared build && pnpm --filter @devtrack/web build"
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm --filter @devtrack/shared build && pnpm --filter @devtrack/api prisma:generate && pnpm --filter @devtrack/api build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
