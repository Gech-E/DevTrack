# PostgreSQL (host → Docker-mapped port 55432; container still listens on 5432)
DATABASE_URL=postgresql://devtrack:devtrack@localhost:55432/devtrack?schema=public
# Only used by docker compose; set a strong value for anything that is not purely local.
POSTGRES_PASSWORD=devtrack

# API
API_PORT=3001
# Development placeholder. With NODE_ENV=production the API refuses to start unless this is a
# strong, unique value of at least 32 characters:  openssl rand -base64 48
JWT_SECRET=change-me-in-development-only
# Comma-separated web origins allowed to call the API (required in production).
CORS_ORIGINS=http://localhost:3000,http://localhost:3101
# Public URL of the web app; used for links in emails.
WEB_APP_URL=http://localhost:3000
# Number of reverse proxies in front of the API (0 locally, usually 1 behind a load balancer).
TRUST_PROXY_HOPS=0

# Email (password reset). "log" prints to the API log in development and delivers nothing
# in production. "resend" sends through https://resend.com (needs the two values below).
MAIL_TRANSPORT=log
# MAIL_FROM=DevTrack <no-reply@your-domain.example>
# RESEND_API_KEY=

# Rate limits per client IP, per window (defaults shown).
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_SENSITIVE_MAX=5

# Web (browser-accessible API URL). Required at build time for production builds.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Shown on the privacy and terms pages as the contact address.
# NEXT_PUBLIC_CONTACT_EMAIL=privacy@your-domain.example
