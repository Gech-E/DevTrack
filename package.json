{
  "name": "devtrack",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @devtrack/shared build && pnpm --filter @devtrack/web dev",
    "dev:api": "pnpm --filter @devtrack/shared build && pnpm --filter @devtrack/api start:dev",
    "build": "pnpm --filter @devtrack/shared build && pnpm --filter @devtrack/api build && pnpm --filter @devtrack/web build",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @devtrack/api test && pnpm --filter @devtrack/web test",
    "test:e2e:api": "pnpm --filter @devtrack/api test:e2e",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @devtrack/api prisma:migrate",
    "db:seed": "pnpm --filter @devtrack/api prisma:seed",
    "db:studio": "pnpm --filter @devtrack/api prisma:studio",
    "deploy:up": "docker compose --profile app up --build -d",
    "deploy:down": "docker compose --profile app down",
    "test:coverage": "pnpm --filter @devtrack/api test:cov && pnpm --filter @devtrack/web test:cov"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.8.2"
  }
}
